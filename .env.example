# ============================================
# Loan Eligibility Notification Agent - ENV
# Copy this file to .env and fill in your keys
# ============================================

# Google Gemini API key (free tier available at 
# https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (free tier available at 
# https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Ollama local server URL (default if running locally)
# Only needed if provider is set to "ollama" in config.yaml
OLLAMA_API_URL=http://localhost:11434
